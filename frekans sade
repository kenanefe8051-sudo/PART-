function getOwnedModes(){try{return JSON.parse(localStorage.getItem('frekans_modes')||'{}');}catch(e){return {};}}
function saveModes(o){localStorage.setItem('frekans_modes',JSON.stringify(o));}
let ownedModes=getOwnedModes();ownedModes.general=true;

let adTimer=null,adSkipEnabled=false,adCallback=null;
const AD_DURATION=30,AD_SKIP_AFTER=5;
let selectedMode='general',selectedRounds=10;

let state={
  teams:[{name:'Takım 1',score:0},{name:'Takım 2',score:0}],
  clueTeam:0,guessTeam:1,round:1,totalRounds:10,
  targetAngle:90,needleAngle:90,concept:null,clue:'',
  phase:'reveal',usedConcepts:[],dragging:false,
};

function show(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if(id==='game')setTimeout(()=>{setupDialEvents();drawDial();},80);
}

function refreshModeBadges(){
  ['couple','friends','family'].forEach(m=>{
    const el=document.getElementById('badge-'+m),card=document.getElementById('mc-'+m);
    if(!el||!card)return;
    if(ownedModes[m]){el.innerHTML='<span class="mc-owned-tag">✓ AÇIK</span>';card.classList.remove('mode-card-locked');}
    else{el.innerHTML=`<span class="mc-lock-tag">🔒 ${MODE_META[m].price}</span>`;card.classList.add('mode-card-locked');}
  });
}

document.getElementById('btnGoModes').addEventListener('click',()=>{refreshModeBadges();show('mode-select');});
document.getElementById('btnModesBack').addEventListener('click',()=>show('splash'));
document.getElementById('btnSetupBack').addEventListener('click',()=>show('mode-select'));
document.getElementById('btnGameHome').addEventListener('click',()=>{if(confirm('Oyundan çıkmak istiyor musun?'))show('splash');});
