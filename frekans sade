<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Frekans 〰️</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;700;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;touch-action:manipulation;}
:root{
  --bg:#0e0b1a;
  --bg2:#13101f;
  --surface:#1a1730;
  --surface2:#201d36;
  --border:rgba(200,190,230,.08);
  --border2:rgba(200,190,230,.14);
  --accent:#8b7ec8;
  --accent2:#b87aaa;
  --text:#e2dff0;
  --text2:rgba(226,223,240,.52);
  --text3:rgba(226,223,240,.26);
}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  overflow:hidden;position:relative;}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(ellipse 60% 40% at 20% 20%,rgba(139,126,200,.06) 0%,transparent 60%),
  radial-gradient(ellipse 50% 35% at 80% 75%,rgba(184,122,170,.06) 0%,transparent 60%);}

.screen{display:none;width:100%;max-width:460px;min-height:100vh;
  padding:24px 20px 80px;flex-direction:column;align-items:center;
  justify-content:center;position:relative;z-index:1;gap:14px;}
.screen.active{display:flex;}
#game{justify-content:flex-start;padding-top:18px;padding-bottom:18px;gap:0;}
#mode-select{justify-content:flex-start;padding-top:44px;gap:14px;}
#setup{justify-content:flex-start;padding-top:44px;gap:15px;}

/* SPLASH */
#splash{text-align:center;gap:0;}
.splash-emoji{font-size:72px;margin-bottom:12px;display:block;animation:bounce 2s infinite;}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.splash-title{font-family:'Bebas Neue',cursive;font-size:58px;line-height:1;
  background:linear-gradient(135deg,#a090d8,#c8a0f0,#b87aaa);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  filter:drop-shadow(0 0 16px rgba(139,126,200,.25));margin-bottom:6px;}
.splash-sub{font-size:13px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;
  margin-bottom:28px;}

/* BUTTONS */
.btn{width:100%;padding:16px 22px;border:none;border-radius:14px;
  font-family:'Nunito',sans-serif;font-size:16px;font-weight:900;
  cursor:pointer;touch-action:manipulation;-webkit-appearance:none;transition:all .18s;}
.btn:active{opacity:.8;}
.btn-primary{background:linear-gradient(135deg,#7060b0,#5040a0);color:#f0eeff;
  box-shadow:0 8px 22px rgba(80,64,160,.3);}
.btn-secondary{background:transparent;color:var(--text2);border:1.5px solid rgba(200,190,230,.1);font-size:14px;}
.btn-ghost{background:transparent;color:var(--text3);font-size:14px;padding:10px;border:none;}
.btn-sm{width:auto;padding:10px 18px;font-size:14px;border-radius:12px;}
.btn-pink{background:linear-gradient(135deg,#8a4a72,#6e3060);color:#f5e0ee;
  box-shadow:0 8px 20px rgba(110,48,96,.3);}
.btn-gold{background:linear-gradient(135deg,#7a6020,#5a4010);color:#f5dfa0;
  box-shadow:0 6px 16px rgba(90,64,16,.3);font-weight:900;}

.label-sm{font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;
  color:var(--accent);align-self:flex-start;opacity:.7;}
.divider{width:100%;height:1px;background:linear-gradient(90deg,transparent,var(--border2),transparent);}
input[type=text]{flex:1;background:transparent;border:none;color:var(--text);
  font-family:'Nunito',sans-serif;font-size:16px;font-weight:700;outline:none;}
input::placeholder{color:var(--text3);}
.team-inputs{display:flex;flex-direction:column;gap:10px;width:100%;}
.team-input-row{display:flex;align-items:center;gap:12px;background:var(--surface);
  border:1.5px solid var(--border);border-radius:14px;padding:14px 16px;}
.team-color-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.rounds-row{display:flex;gap:8px;width:100%;}
.round-btn{flex:1;padding:12px 6px;border:1.5px solid var(--border);border-radius:12px;
  background:transparent;font-family:'Nunito',sans-serif;font-size:16px;font-weight:900;
  color:var(--text3);cursor:pointer;transition:all .15s;}
.round-btn.active{background:rgba(139,126,200,.1);border-color:rgba(139,126,200,.3);color:var(--accent);}

/* MODE SELECT */
.mode-select-title{font-family:'Bebas Neue',cursive;font-size:34px;letter-spacing:1px;
  align-self:flex-start;color:var(--text);}
.mode-cards{display:flex;flex-direction:column;gap:11px;width:100%;}
.mode-card{width:100%;border:none;border-radius:20px;padding:18px 20px;
  display:flex;align-items:center;gap:14px;text-align:left;
  cursor:pointer;-webkit-appearance:none;transition:all .2s;position:relative;overflow:hidden;}
.mode-card:active{opacity:.82;}
.mode-card-free{background:linear-gradient(135deg,#18203a,#121830);border:1.5px solid rgba(139,126,200,.25);}
.mode-card-couple{background:linear-gradient(135deg,#2a1828,#201220);border:1.5px solid rgba(184,122,170,.25);}
.mode-card-friends{background:linear-gradient(135deg,#28200e,#201808);border:1.5px solid rgba(200,170,80,.22);}
.mode-card-family{background:linear-gradient(135deg,#121a30,#0e1428);border:1.5px solid rgba(100,120,200,.22);}
.mc-icon{font-size:38px;flex-shrink:0;}
.mc-info{flex:1;}
.mc-name{font-family:'Bebas Neue',cursive;font-size:22px;color:#fff;letter-spacing:.5px;margin-bottom:3px;}
.mc-desc{font-size:12px;color:rgba(226,223,240,.45);font-weight:700;line-height:1.4;}
.mc-badge{display:flex;align-items:center;gap:5px;margin-top:6px;}
.mc-free-tag{background:rgba(139,126,200,.12);border:1px solid rgba(139,126,200,.25);
  border-radius:20px;padding:2px 10px;font-size:11px;font-weight:900;color:var(--accent);}
.mc-lock-tag{background:rgba(180,150,60,.1);border:1px solid rgba(180,150,60,.22);
  border-radius:20px;padding:2px 10px;font-size:11px;font-weight:900;
  color:rgba(200,175,90,.7);display:flex;align-items:center;gap:4px;}
.mc-owned-tag{background:rgba(139,126,200,.12);border:1px solid rgba(139,126,200,.25);
  border-radius:20px;padding:2px 10px;font-size:11px;font-weight:900;color:var(--accent);}
.mode-card-locked{opacity:.72;}
.mode-card-locked::after{content:'🔒';position:absolute;top:14px;right:16px;font-size:16px;opacity:.4;}

/* SETUP */
.setup-heading{font-family:'Bebas Neue',cursive;font-size:30px;letter-spacing:.5px;
  align-self:flex-start;color:var(--text);}

/* GAME */
.game-top{width:100%;display:flex;justify-content:space-between;align-items:center;margin-bottom:11px;}
.round-badge{font-size:12px;font-weight:700;letter-spacing:1px;color:var(--text3);text-transform:uppercase;}
.mode-chip{font-size:11px;font-weight:900;padding:3px 10px;border-radius:20px;}
.scores-row{display:flex;gap:9px;width:100%;margin-bottom:11px;}
.score-card{flex:1;border-radius:14px;padding:11px 14px;background:var(--surface);
  border:1.5px solid var(--border);transition:all .35s;}
.score-card.active{background:rgba(139,126,200,.08);border-color:rgba(139,126,200,.28);}
.score-card.active-pink{background:rgba(184,122,170,.08);border-color:rgba(184,122,170,.28);}
.sc-team{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--text3);margin-bottom:3px;}
.sc-score{font-family:'Bebas Neue',cursive;font-size:34px;line-height:1;color:var(--text2);}
.score-card.active .sc-score{color:var(--accent);}
.score-card.active-pink .sc-score{color:var(--accent2);}
.concept-bar{width:100%;display:flex;align-items:center;gap:10px;margin-bottom:8px;
  background:var(--surface);border:1.5px solid var(--border);border-radius:14px;padding:13px 16px;}
.concept-word{font-family:'Bebas Neue',cursive;font-size:18px;flex:1;}
.concept-left{color:#b08878;text-align:left;}
.concept-right{color:#7888aa;text-align:right;}
.concept-sep{color:var(--text3);font-size:16px;flex-shrink:0;}
.dial-wrap{width:100%;margin:2px 0 5px;}
#dialCanvas{width:100%;display:block;cursor:pointer;touch-action:none;}
.phase-strip{width:100%;background:var(--surface);border:1.5px solid var(--border);
  border-radius:12px;padding:8px 16px;font-size:13px;font-weight:700;
  color:var(--text3);text-align:center;margin-bottom:5px;}
.phase-strip span{color:var(--accent);}
.phase-strip span.pink{color:var(--accent2);}
.clue-box{width:100%;background:rgba(139,126,200,.04);border:1.5px solid rgba(139,126,200,.12);
  border-radius:14px;padding:13px 15px;display:flex;flex-direction:column;gap:7px;}
.clue-box.pink-mode{background:rgba(184,122,170,.04);border-color:rgba(184,122,170,.12);}
.clue-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--accent);opacity:.7;}
.clue-box.pink-mode .clue-label{color:var(--accent2);}
.clue-input{background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.07);
  border-radius:10px;padding:11px 14px;color:var(--text);font-family:'Nunito',sans-serif;
  font-size:16px;font-weight:700;outline:none;width:100%;}
.clue-input:focus{border-color:rgba(139,126,200,.3);}
.clue-display{font-family:'Bebas Neue',cursive;font-size:26px;text-align:center;
  letter-spacing:1px;padding:3px 0;}
.result-banner{width:100%;border-radius:13px;padding:13px 18px;text-align:center;
  font-family:'Bebas Neue',cursive;font-size:20px;letter-spacing:1px;
  animation:bannerIn .4s cubic-bezier(.175,.885,.32,1.275);}
@keyframes bannerIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
.res-4{background:rgba(80,150,110,.12);border:1.5px solid rgba(80,150,110,.3);color:#7aaa90;}
.res-3{background:rgba(90,130,160,.1);border:1.5px solid rgba(90,130,160,.28);color:#80a8c0;}
.res-2{background:rgba(150,140,70,.1);border:1.5px solid rgba(150,140,70,.26);color:#a89e58;}
.res-1{background:rgba(160,110,60,.1);border:1.5px solid rgba(160,110,60,.24);color:#a87848;}
.res-0{background:rgba(160,70,70,.1);border:1.5px solid rgba(160,70,70,.22);color:#a06060;}
.game-actions{display:flex;gap:8px;width:100%;margin-top:5px;}

/* RESULT */
#result-screen{text-align:center;gap:14px;}
.winner-badge{font-size:64px;animation:bounce 1.8s infinite;}
.winner-title{font-size:11px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--text3);}
.winner-name{font-family:'Bebas Neue',cursive;font-size:clamp(28px,8vw,44px);
  color:var(--accent);margin:4px 0 14px;letter-spacing:1px;}
.final-scores{width:100%;display:flex;flex-direction:column;gap:8px;}
.fs-row{display:flex;align-items:center;justify-content:space-between;
  background:var(--surface);border:1.5px solid var(--border);border-radius:14px;padding:14px 18px;}
.fs-row.winner-row{background:rgba(139,126,200,.08);border-color:rgba(139,126,200,.24);}
.fs-name{font-weight:900;font-size:15px;}
.fs-score{font-family:'Bebas Neue',cursive;font-size:26px;}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;z-index:500;
  background:rgba(6,4,16,.85);backdrop-filter:blur(8px);
  align-items:flex-end;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal-sheet{width:100%;max-width:460px;background:var(--bg2);
  border:1.5px solid var(--border2);border-bottom:none;
  border-radius:22px 22px 0 0;padding:22px 22px 44px;
  display:flex;flex-direction:column;gap:14px;
  animation:sheetUp .3s cubic-bezier(.25,.8,.25,1);}
@keyframes sheetUp{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-handle{width:36px;height:4px;border-radius:2px;background:var(--border2);align-self:center;margin-bottom:2px;}
.modal-title{font-family:'Bebas Neue',cursive;font-size:22px;color:var(--text);letter-spacing:.5px;}
.unlock-hero{text-align:center;padding:6px 0;}
.unlock-icon{font-size:52px;margin-bottom:8px;display:block;}
.unlock-name{font-family:'Bebas Neue',cursive;font-size:26px;color:var(--text);letter-spacing:.5px;}
.unlock-desc{font-size:13px;color:var(--text2);margin-top:5px;line-height:1.55;}
.unlock-features{width:100%;display:flex;flex-direction:column;gap:7px;}
.uf-row{display:flex;align-items:flex-start;gap:12px;padding:10px 14px;
  background:var(--surface);border:1px solid var(--border);border-radius:12px;}
.uf-icon{font-size:18px;flex-shrink:0;margin-top:1px;}
.uf-text{font-size:13px;color:var(--text2);line-height:1.4;}
.uf-text b{color:var(--text);}
.price-row{display:flex;align-items:center;justify-content:center;
  padding:13px;background:rgba(139,126,200,.06);border:1.5px solid rgba(139,126,200,.14);border-radius:14px;}
.price-main{font-family:'Bebas Neue',cursive;font-size:32px;color:var(--accent);}
.price-sub{font-size:12px;color:var(--text3);margin-top:2px;}
.how-to{width:100%;display:flex;flex-direction:column;gap:8px;}
.how-step{display:flex;align-items:flex-start;gap:12px;padding:11px 14px;
  background:var(--surface);border:1px solid var(--border);border-radius:12px;}
.how-num{font-size:10px;font-weight:900;color:var(--accent);
  background:rgba(139,126,200,.1);border-radius:6px;padding:2px 8px;flex-shrink:0;margin-top:1px;}
.how-text{font-size:13px;color:var(--text2);line-height:1.55;}

/* AD */
.ad-overlay{display:none;position:fixed;inset:0;z-index:900;
  background:rgba(6,4,16,.92);backdrop-filter:blur(8px);
  align-items:center;justify-content:center;flex-direction:column;}
.ad-overlay.open{display:flex;}
.ad-card{width:100%;max-width:370px;margin:0 16px;background:var(--surface2);
  border:1.5px solid var(--border2);border-radius:20px;overflow:hidden;}
.ad-header{display:flex;align-items:center;justify-content:space-between;
  padding:10px 14px;background:rgba(255,255,255,.02);border-bottom:1px solid var(--border);}
.ad-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--text3);}
.ad-skip-btn{font-family:'Nunito',sans-serif;font-size:12px;font-weight:900;
  background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.08);
  border-radius:8px;padding:5px 13px;color:var(--text2);cursor:pointer;min-width:90px;text-align:center;}
.ad-skip-btn.ready{background:rgba(139,126,200,.12);border-color:rgba(139,126,200,.28);color:var(--accent);}
.ad-body{padding:28px 22px;text-align:center;}
.ad-emoji{font-size:44px;margin-bottom:10px;display:block;}
.ad-title{font-family:'Bebas Neue',cursive;font-size:20px;color:var(--text);margin-bottom:5px;letter-spacing:.5px;}
.ad-desc{font-size:13px;color:var(--text2);line-height:1.5;margin-bottom:16px;}
.ad-cta{display:inline-block;padding:9px 20px;background:rgba(139,126,200,.15);
  border:1px solid rgba(139,126,200,.28);border-radius:10px;font-size:13px;font-weight:900;color:var(--accent);}
.ad-progress{width:100%;height:3px;background:rgba(255,255,255,.05);}
.ad-progress-bar{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));width:0%;}
.ad-hint{font-size:11px;color:var(--text3);margin-top:13px;font-weight:700;}

.fab-help{position:fixed;bottom:22px;right:22px;width:46px;height:46px;border-radius:50%;
  background:var(--surface2);border:1.5px solid var(--border2);color:var(--accent);
  font-family:'Bebas Neue',cursive;font-size:22px;cursor:pointer;z-index:100;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 14px rgba(0,0,0,.3);-webkit-appearance:none;touch-action:manipulation;}
.fab-help:active{transform:scale(.92);}
#confetti{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:999;}
</style>
</head>
<body>
<canvas id="confetti"></canvas>

<!-- HELP -->
<div class="modal-overlay" id="helpModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="modal-title">〰️ Nasıl Oynanır?</div>
    <div class="how-to">
      <div class="how-step"><span class="how-num">01</span>
        <div class="how-text">Bir kavram çifti belirir: <b style="color:#b08878">Sıcak</b> ↔ <b style="color:#7888aa">Soğuk</b> gibi.</div></div>
      <div class="how-step"><span class="how-num">02</span>
        <div class="how-text"><b style="color:var(--accent)">İpucu veren takım</b> kadrandaki hedef bölgeyi görür. Diğer takım bakamaz!</div></div>
      <div class="how-step"><span class="how-num">03</span>
        <div class="how-text">Hedef gizlenir. İpucu veren takım <b style="color:var(--accent)">tek kelime</b> ipucu verir.</div></div>
      <div class="how-step"><span class="how-num">04</span>
        <div class="how-text"><b style="color:var(--accent2)">Diğer takım</b> kırmızı ibreyi çevirerek tahmin eder. Ne kadar yakın = o kadar puan! 🎯</div></div>
      <div class="how-step"><span class="how-num">🏆</span>
        <div class="how-text">Tam isabet <b>+4 puan</b> · Çok yakın +3 · Yakın +2 · Az kaldı +1. Her turda roller değişir!</div></div>
    </div>
    <button class="btn btn-primary" id="btnCloseHelp">ANLADIM ✓</button>
  </div>
</div>

<!-- UNLOCK -->
<div class="modal-overlay" id="unlockModal">
  <div class="modal-sheet">
    <div class="modal-handle"></div>
    <div class="unlock-hero">
      <span class="unlock-icon" id="unlockIcon">💑</span>
      <div class="unlock-name" id="unlockName">MOD ADI</div>
      <div class="unlock-desc" id="unlockDesc">Açıklama</div>
    </div>
    <div class="unlock-features" id="unlockFeatures"></div>
    <div class="price-row">
      <div style="text-align:center;">
        <div class="price-main" id="unlockPrice">₺30</div>
        <div class="price-sub">tek seferlik · sadece bu mod</div>
      </div>
    </div>
    <button class="btn btn-gold" id="btnUnlockBuy">SATIN AL ⭐</button>
    <button class="btn btn-ghost" id="btnUnlockClose">Belki daha sonra</button>
  </div>
</div>

<!-- AD -->
<div class="ad-overlay" id="adOverlay">
  <div class="ad-card">
    <div class="ad-header">
      <span class="ad-label">📺 Reklam</span>
      <button class="ad-skip-btn" id="adSkipBtn">5s bekle...</button>
    </div>
    <div class="ad-body">
      <span class="ad-emoji" id="adEmoji">🎮</span>
      <div class="ad-title" id="adTitle">Reklam</div>
      <div class="ad-desc" id="adDesc">Açıklama</div>
      <div class="ad-cta" id="adCta">Daha Fazla</div>
    </div>
    <div class="ad-progress"><div class="ad-progress-bar" id="adProgressBar"></div></div>
  </div>
  <div class="ad-hint">Modu satın alırsan reklam görmezsin 🎉</div>
</div>

<!-- SPLASH -->
<div id="splash" class="screen active">
  <span class="splash-emoji">〰️</span>
  <div class="splash-title">FREKANS</div>
  <div class="splash-sub">Frekansını bul</div>
  <button class="btn btn-primary" id="btnGoModes" style="margin-top:12px;">OYNA →</button>
</div>

<!-- MOD SEÇİM -->
<div id="mode-select" class="screen">
  <div class="mode-select-title">Mod Seç</div>
  <div style="font-size:13px;color:var(--text3);align-self:flex-start;margin-top:-8px;font-weight:700;">Her modun kendine özel kavramları var</div>
  <div class="mode-cards" id="modeCards">
    <button class="mode-card mode-card-free" data-mode="general">
      <div class="mc-icon">〰️</div>
      <div class="mc-info">
        <div class="mc-name">Genel</div>
        <div class="mc-desc">Herkes için evrensel kavramlar · Geniş konu yelpazesi</div>
        <div class="mc-badge"><span class="mc-free-tag">ÜCRETSİZ</span></div>
      </div>
    </button>
    <button class="mode-card mode-card-couple" data-mode="couple" id="mc-couple">
      <div class="mc-icon">💑</div>
      <div class="mc-info">
        <div class="mc-name">Çiftler</div>
        <div class="mc-desc">İlişkiler, duygular, birlikte anlar · Partnerinizi ne kadar tanıyorsunuz?</div>
        <div class="mc-badge" id="badge-couple"><span class="mc-lock-tag">🔒 ₺30</span></div>
      </div>
    </button>
    <button class="mode-card mode-card-friends" data-mode="friends" id="mc-friends">
      <div class="mc-icon">🍻</div>
      <div class="mc-info">
        <div class="mc-name">Arkadaşlar 18+</div>
