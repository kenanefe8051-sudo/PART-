function showAd(cb){
  if(ownedModes[selectedMode]&&selectedMode!=='general'){cb();return;}
  adCallback=cb;adSkipEnabled=false;
  const ad=ADS[Math.floor(Math.random()*ADS.length)];
  document.getElementById('adEmoji').textContent=ad.emoji;
  document.getElementById('adTitle').textContent=ad.title;
  document.getElementById('adDesc').textContent=ad.desc;
  document.getElementById('adCta').textContent=ad.cta;
  document.getElementById('adProgressBar').style.width='0%';
  document.getElementById('adSkipBtn').textContent=`${AD_SKIP_AFTER}s bekle...`;
  document.getElementById('adSkipBtn').className='ad-skip-btn';
  document.getElementById('adOverlay').classList.add('open');
  let elapsed=0;clearInterval(adTimer);
  adTimer=setInterval(()=>{
    elapsed+=100;
    document.getElementById('adProgressBar').style.width=Math.min((elapsed/(AD_DURATION*1000))*100,100)+'%';
    if(elapsed>=AD_SKIP_AFTER*1000&&!adSkipEnabled){
      adSkipEnabled=true;document.getElementById('adSkipBtn').textContent='Geç ⟩⟩';document.getElementById('adSkipBtn').className='ad-skip-btn ready';
    }else if(!adSkipEnabled)document.getElementById('adSkipBtn').textContent=`${Math.ceil((AD_SKIP_AFTER*1000-elapsed)/1000)}s bekle...`;
    if(elapsed>=AD_DURATION*1000){clearInterval(adTimer);closeAd();}
  },100);
}
function closeAd(){clearInterval(adTimer);document.getElementById('adOverlay').classList.remove('open');if(adCallback){adCallback();adCallback=null;}}
document.getElementById('adSkipBtn').addEventListener('click',()=>{if(adSkipEnabled)closeAd();});

function pickConcept(){
  const all=CONCEPT_PACKS[selectedMode]||CONCEPT_PACKS.general;
  let pool=all.map((_,i)=>i).filter(i=>!state.usedConcepts.includes(i));
  if(!pool.length){state.usedConcepts=[];pool=all.map((_,i)=>i);}
  const idx=pool[Math.floor(Math.random()*pool.length)];
  state.usedConcepts.push(idx);return all[idx];
}
function newRound(){
  state.concept=pickConcept();state.targetAngle=15+Math.random()*150;
  state.needleAngle=90;state.clue='';state.phase='reveal';renderGame();
}

function renderGame(){
  const t=state.teams,ct=state.clueTeam,gt=state.guessTeam;
  document.getElementById('roundBadge').textContent=`TUR ${state.round} / ${state.totalRounds}`;
  ['sc0','sc1'].forEach((id,i)=>{
    const el=document.getElementById(id);
    const active=(state.phase==='guess'||state.phase==='result')?gt:ct;
    el.className='score-card'+(i===active?(i===0?' active':' active-pink'):'');
    document.getElementById('scName'+i).textContent=t[i].name.toUpperCase();
    document.getElementById('scScore'+i).textContent=t[i].score;
  });
  document.getElementById('conceptLeft').textContent=state.concept[0];
  document.getElementById('conceptRight').textContent=state.concept[1];
  const pl=document.getElementById('phaseLabel');
  if(state.phase==='reveal'){pl.className=ct===0?'':'pink';pl.textContent=`${t[ct].name} hedefi görüyor`;}
  else if(state.phase==='clue'){pl.className=ct===0?'':'pink';pl.textContent=`${t[ct].name} — İpucu Veriyor`;}
  else if(state.phase==='guess'){pl.className=gt===0?'':'pink';pl.textContent=`${t[gt].name} — Tahmin Ediyor`;}
  else{pl.className='';pl.textContent='Sonuç!';}
  const box=document.getElementById('clueBox'),inp=document.getElementById('clueInput'),lbl=document.getElementById('clueBoxLabel');
  box.querySelectorAll('.clue-display,.reveal-info').forEach(e=>e.remove());
  if(state.phase==='reveal'){
    box.className='clue-box'+(ct===0?'':' pink-mode');box.style.display='flex';
    lbl.textContent='HEDEFİ GÖR — İPUCU HAZIRLA';inp.style.display='none';
    const d=document.createElement('div');d.className='reveal-info';
    d.style.cssText='font-size:13px;color:rgba(226,223,240,.45);line-height:1.65;text-align:center;padding:3px 0;';
    d.innerHTML=`Parlak bölge <b style="color:var(--accent)">hedef alandır</b>.<br>Diğer takım bakmasın!`;
    box.appendChild(d);
  }else if(state.phase==='clue'){
    box.className='clue-box'+(ct===0?'':' pink-mode');box.style.display='flex';
    lbl.textContent='İPUCUNU YAZ (1 KELİME)';inp.style.display='block';
    inp.value=state.clue;inp.disabled=false;setTimeout(()=>inp.focus(),100);
  }else if(state.phase==='guess'){
    box.className='clue-box'+(gt===0?'':' pink-mode');box.style.display='flex';
    lbl.textContent='VERİLEN İPUCU';inp.style.display='none';
    const d=document.createElement('div');d.className='clue-display';
    d.textContent=state.clue||'—';d.style.color=gt===0?'var(--accent)':'var(--accent2)';box.appendChild(d);
  }else{box.style.display='none';}
  if(state.phase!=='result')document.getElementById('resultBanner').style.display='none';
  const btn=document.getElementById('btnAction');
  btn.style.flex='1';
  if(state.phase==='reveal'){btn.textContent='HAZIR — İPUCU GİR →';btn.className='btn btn-sm'+(ct===0?' btn-primary':' btn-pink');}
  else if(state.phase==='clue'){btn.textContent='İPUCU KİLİTLE 🔒';btn.className='btn btn-sm'+(ct===0?' btn-primary':' btn-pink');}
  else if(state.phase==='guess'){btn.textContent='TAHMİN ET ✓';btn.className='btn btn-sm'+(gt===0?' btn-primary':' btn-pink');}
  else{btn.textContent=state.round>=state.totalRounds?'OYUNU BİTİR 🏁':'SONRAKİ TUR →';btn.className='btn btn-primary btn-sm';}
  drawDial();
}

document.getElementById('btnAction').addEventListener('click',handleAction);
document.getElementById('clueInput').addEventListener('keydown',e=>{if(e.key==='Enter')handleAction();});

function handleAction(){
  if(state.phase==='reveal'){state.phase='clue';renderGame();}
  else if(state.phase==='clue'){
    const v=document.getElementById('clueInput').value.trim();
    if(!v){const i=document.getElementById('clueInput');i.style.borderColor='rgba(184,122,170,.4)';i.placeholder='Bir kelime yaz!';setTimeout(()=>{i.style.borderColor='';i.placeholder='Kelime ipucu...';},1000);return;}
    state.clue=v;state.needleAngle=90;state.phase='guess';renderGame();
  }else if(state.phase==='guess'){
    state.phase='result';
    const diff=Math.abs(state.needleAngle-state.targetAngle);
    let pts=0;
    if(diff<=4)pts=4;else if(diff<=9)pts=3;else if(diff<=16)pts=2;else if(diff<=24)pts=1;
    state.teams[state.guessTeam].score+=pts;renderGame();
    const bn=document.getElementById('resultBanner');bn.style.display='block';
    bn.textContent={4:'🎯 TAM 12! +4 PUAN',3:'✦ ÇOK YAKIN! +3 PUAN',2:'~ YAKIN! +2 PUAN',1:'△ AZ KALDI! +1 PUAN',0:'✕ ISKALADIN! 0 PUAN'}[pts];
    bn.className='result-banner res-'+pts;
    if(pts>=3){playSuccess();launchConfetti();}else if(pts===0)playFail();else playOk();
    drawDial();
  }else{
    if(state.round>=state.totalRounds){showAd(()=>showResult());}
    else{
      const doAd=state.round%3===0;
      state.round++;const tmp=state.clueTeam;state.clueTeam=state.guessTeam;state.guessTeam=tmp;
      if(doAd)showAd(()=>newRound());else newRound();
    }
  }
}

function showResult(){
  const sorted=[...state.teams].sort((a,b)=>b.score-a.score);
  const isDraw=state.teams[0].score===state.teams[1].score;
  document.getElementById('winnerEmoji').textContent=isDraw?'🤝':'🏆';
  document.getElementById('winnerName').textContent=isDraw?'BERABERE!':sorted[0].name.toUpperCase();
  document.getElementById('finalScores').innerHTML=sorted.map((t,i)=>`
    <div class="fs-row ${i===0&&!isDraw?'winner-row':''}">
      <span class="fs-name">${t.name}</span>
      <span class="fs-score" style="color:${i===0&&!isDraw?'var(--accent)':'var(--text3)'}">${t.score}</span>
    </div>`).join('');
  show('result-screen');setTimeout(()=>launchConfetti(),200);
}

/* ── KADRAN ── */
function drawDial(){
  const cv=document.getElementById('dialCanvas');
  const W=cv.offsetWidth||420;
  const TW=Math.round(W*0.086);
  const R=W*0.41;
  const H=R+TW/2+28;
  cv.width=W;cv.height=Math.round(H);
  const ctx=cv.getContext('2d');
  ctx.clearRect(0,0,W,H);
  const cx=W/2,cy=H;
  const isGuess=state.phase==='guess',isResult=state.phase==='result',isReveal=state.phase==='reveal';
  const showTarget=isReveal||isResult;

  /* Tick marklar */
  const tickOut=R+TW/2+2;
  for(let i=0;i<=18;i++){
    const a=Math.PI+(i/18)*Math.PI,maj=i%3===0,len=maj?11:5;
    ctx.beginPath();
    ctx.moveTo(cx+Math.cos(a)*tickOut,cy+Math.sin(a)*tickOut);
    ctx.lineTo(cx+Math.cos(a)*(tickOut+len),cy+Math.sin(a)*(tickOut+len));
    ctx.strokeStyle=maj?'rgba(200,190,230,.18)':'rgba(200,190,230,.06)';
    ctx.lineWidth=maj?1.5:1;ctx.stroke();
  }
  /* Kavram etiketleri */
  if(state.concept){
    const lr=tickOut+18;
    ctx.font=`bold 11px 'Nunito',sans-serif`;ctx.textBaseline='middle';
    ctx.fillStyle='#b08878';ctx.textAlign='left';
    ctx.fillText(state.concept[0],cx+Math.cos(Math.PI)*lr-30,cy+Math.sin(Math.PI)*lr);
    ctx.fillStyle='#7888aa';ctx.textAlign='right';
    ctx.fillText(state.concept[1],cx+Math.cos(2*Math.PI)*lr+30,cy+Math.sin(2*Math.PI)*lr);
  }

  /* Track */
  ctx.beginPath();ctx.arc(cx,cy,R,Math.PI,2*Math.PI);
  ctx.strokeStyle='#0a0818';ctx.lineWidth=TW+6;ctx.stroke();
  /* Baz rengi — yumuşak gradient */
  const bg=ctx.createLinearGradient(cx-R,0,cx+R,0);
  bg.addColorStop(0,'rgba(140,80,70,.2)');
  bg.addColorStop(.5,'rgba(139,126,200,.06)');
  bg.addColorStop(1,'rgba(70,90,150,.2)');
  ctx.beginPath();ctx.arc(cx,cy,R,Math.PI,2*Math.PI);
  ctx.strokeStyle=bg;ctx.lineWidth=TW;ctx.stroke();
  /* Kenar çizgileri */
  ctx.beginPath();ctx.arc(cx,cy,R-TW/2,Math.PI,2*Math.PI);ctx.strokeStyle='rgba(255,255,255,.04)';ctx.lineWidth=1;ctx.stroke();
  ctx.beginPath();ctx.arc(cx,cy,R+TW/2,Math.PI,2*Math.PI);ctx.strokeStyle='rgba(255,255,255,.04)';ctx.lineWidth=1;ctx.stroke();

  /* Hedef bölgeler — yumuşak, neon değil */
  if(showTarget){
    const zones=[
      {spread:54,r:160,g:120,b:60,op:.55},
      {spread:34,r:155,g:150,b:55,op:.70},
      {spread:19,r:70,g:140,b:90,op:.82},
      {spread:8, r:100,g:160,b:110,op:.95},
    ];
    zones.forEach(z=>{
      const a1=Math.PI+(state.targetAngle-z.spread/2)/180*Math.PI;
      const a2=Math.PI+(state.targetAngle+z.spread/2)/180*Math.PI;
      ctx.beginPath();ctx.arc(cx,cy,R,a1,a2);
      ctx.strokeStyle=`rgba(${z.r},${z.g},${z.b},${z.op})`;ctx.lineWidth=TW;ctx.stroke();
    });
    /* Bölge ayırıcılar */
    [27,17,9].forEach(d=>{[-1,1].forEach(side=>{
      const a=Math.PI+(state.targetAngle+side*d)/180*Math.PI;
      ctx.beginPath();
      ctx.moveTo(cx+Math.cos(a)*(R-TW/2),cy+Math.sin(a)*(R-TW/2));
      ctx.lineTo(cx+Math.cos(a)*(R+TW/2),cy+Math.sin(a)*(R+TW/2));
      ctx.strokeStyle='rgba(8,6,20,.6)';ctx.lineWidth=2;ctx.stroke();
    });});
    /* Merkez çizgi */
    const ta=Math.PI+state.targetAngle/180*Math.PI;
    ctx.beginPath();
    ctx.moveTo(cx+Math.cos(ta)*(R-TW/2-2),cy+Math.sin(ta)*(R-TW/2-2));
    ctx.lineTo(cx+Math.cos(ta)*(R+TW/2+2),cy+Math.sin(ta)*(R+TW/2+2));
    ctx.strokeStyle='rgba(240,235,220,.8)';ctx.lineWidth=2;ctx.lineCap='round';ctx.stroke();
    /* Merkez top */
    const dx=cx+Math.cos(ta)*R,dy=cy+Math.sin(ta)*R;
    ctx.beginPath();ctx.arc(dx,dy,6,0,2*Math.PI);
    ctx.fillStyle='rgba(240,235,220,.7)';ctx.fill();
  }

  /* ── İBRE — klasik kırmızı, derece yazısı YOK ── */
  if(isGuess||isResult){
    const na=Math.PI+state.needleAngle/180*Math.PI;
    const tip=R+TW/2+4;
    /* Gölge */
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+Math.cos(na)*tip,cy+Math.sin(na)*tip);
    ctx.strokeStyle='rgba(0,0,0,.35)';ctx.lineWidth=7;ctx.lineCap='round';ctx.stroke();
    /* Gövde — mat kırmızı, gradient */
    const ng=ctx.createLinearGradient(cx,cy,cx+Math.cos(na)*tip,cy+Math.sin(na)*tip);
    ng.addColorStop(0,'#8b2020');ng.addColorStop(0.6,'#b03030');ng.addColorStop(1,'#cc4040');
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+Math.cos(na)*tip,cy+Math.sin(na)*tip);
    ctx.strokeStyle=ng;ctx.lineWidth=4;ctx.lineCap='round';
    ctx.shadowColor='rgba(160,40,40,.3)';ctx.shadowBlur=isGuess?8:3;ctx.stroke();ctx.shadowBlur=0;
    /* Uç */
    const tx=cx+Math.cos(na)*tip,ty=cy+Math.sin(na)*tip;
    ctx.beginPath();ctx.arc(tx,ty,5,0,2*Math.PI);
    ctx.fillStyle='#cc4040';ctx.fill();
    /* Merkez daire — klasik */
    ctx.beginPath();ctx.arc(cx,cy,11,0,2*Math.PI);ctx.fillStyle='#110e20';ctx.fill();
    ctx.beginPath();ctx.arc(cx,cy,8,0,2*Math.PI);ctx.fillStyle='#8b2020';ctx.fill();
    ctx.beginPath();ctx.arc(cx,cy,4,0,2*Math.PI);ctx.fillStyle='#c8a0a0';ctx.fill();
    /* DERECE YAZISI YOK — kaldırıldı kullanıcı isteğiyle */
  }else{
    ctx.beginPath();ctx.arc(cx,cy,8,0,2*Math.PI);ctx.fillStyle='rgba(200,190,230,.07)';ctx.fill();
    ctx.beginPath();ctx.arc(cx,cy,3,0,2*Math.PI);ctx.fillStyle='rgba(200,190,230,.15)';ctx.fill();
  }
}

function setupDialEvents(){
  const cv=document.getElementById('dialCanvas');
  cv.removeEventListener('mousedown',onDown);cv.removeEventListener('touchstart',onTouchStart);
  cv.addEventListener('mousedown',onDown);cv.addEventListener('touchstart',onTouchStart,{passive:false});
}
function getAngle(e,cv){
  const rc=cv.getBoundingClientRect();
  const x=(e.touches?e.touches[0].clientX:e.clientX)-rc.left-rc.width/2;
  const y=(e.touches?e.touches[0].clientY:e.clientY)-rc.top-rc.height;
  let a=Math.atan2(y,x)*180/Math.PI-180;if(a<0)a+=360;return Math.max(0,Math.min(180,a));
}
function onDown(e){if(state.phase!=='guess')return;state.dragging=true;state.needleAngle=getAngle(e,e.currentTarget);drawDial();document.addEventListener('mousemove',onMove);document.addEventListener('mouseup',onUp);}
function onMove(e){if(!state.dragging||state.phase!=='guess')return;e.preventDefault();state.needleAngle=getAngle(e,document.getElementById('dialCanvas'));drawDial();}
function onUp(){state.dragging=false;document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',onUp);}
function onTouchStart(e){if(state.phase!=='guess')return;e.preventDefault();state.needleAngle=getAngle(e,e.currentTarget);drawDial();e.currentTarget.addEventListener('touchmove',onTouchMove,{passive:false});e.currentTarget.addEventListener('touchend',onTouchEnd);}
function onTouchMove(e){if(state.phase!=='guess')return;e.preventDefault();state.needleAngle=getAngle(e,e.currentTarget);drawDial();}
function onTouchEnd(e){e.currentTarget.removeEventListener('touchmove',onTouchMove);e.currentTarget.removeEventListener('touchend',onTouchEnd);}
window.addEventListener('resize',()=>{if(document.getElementById('game').classList.contains('active'))drawDial();});

let AC;
function ac(){if(!AC)AC=new(window.AudioContext||window.webkitAudioContext)();if(AC.state==='suspended')AC.resume();return AC;}
function playSuccess(){const c=ac();[523,659,784,1047].forEach((f,i)=>{const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.type='sine';o.frequency.value=f;const t=c.currentTime+i*.09;g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.15,t+.02);g.gain.exponentialRampToValueAtTime(.001,t+.22);o.start(t);o.stop(t+.22);});}
function playOk(){const c=ac();[440,550].forEach((f,i)=>{const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.type='sine';o.frequency.value=f;const t=c.currentTime+i*.1;g.gain.setValueAtTime(.1,t);g.gain.exponentialRampToValueAtTime(.001,t+.2);o.start(t);o.stop(t+.2);});}
function playFail(){const c=ac();[280,220].forEach((f,i)=>{const o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.type='sawtooth';o.frequency.value=f;const t=c.currentTime+i*.13;g.gain.setValueAtTime(.1,t);g.gain.exponentialRampToValueAtTime(.001,t+.22);o.start(t);o.stop(t+.23);});}

const CONF=['#8b7ec8','#b87aaa','#c8a870','#7888aa','#a09090','#c0b8e0'];
let confP=[],confR;
function launchConfetti(){
  const cv=document.getElementById('confetti');
  const W=cv.width=window.innerWidth,H=cv.height=window.innerHeight;
  const ctx=cv.getContext('2d');confP=[];
  for(let i=0;i<130;i++){const a=(Math.random()*360)*Math.PI/180,sp=3+Math.random()*5;
    confP.push({x:W/2+(Math.random()-.5)*W*.7,y:H*.45,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-5,
      w:5+Math.random()*6,h:4+Math.random()*5,rot:Math.random()*360,rv:(Math.random()-.5)*6,
      c:CONF[Math.floor(Math.random()*CONF.length)],life:1});}
  cancelAnimationFrame(confR);
  function draw(){ctx.clearRect(0,0,W,H);let alive=false;
    confP.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.24;p.vx*=.99;p.rot+=p.rv;p.life-=.013;
      const a=Math.max(0,p.life);if(a>0){alive=true;ctx.save();ctx.globalAlpha=a;ctx.translate(p.x,p.y);
        ctx.rotate(p.rot*Math.PI/180);ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();}});
    if(alive)confR=requestAnimationFrame(draw);else ctx.clearRect(0,0,W,H);}
  draw();
}
